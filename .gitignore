# Root ignore rules. prototype/.gitignore (original archive file) still applies inside prototype/.

# Secrets and local environment (never commit real values)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key

# Dependencies and package-manager state
node_modules/
.pnpm-store/
.sites-runtime/

# Build output and framework/runtime state
dist/
.next/
.vinext/
.wrangler/
*.tsbuildinfo

# Test output and local harness builds
test-results/
playwright-report/
coverage/
prototype/tests/harness/.build/
prototype/tests/artifacts/

# Logs and OS / editor metadata
*.log
.DS_Store
.vscode/
.idea/
