{
  "type": "object",
  "required": [
    "id",
    "version",
    "scenario_id",
    "scenario_version",
    "review_notice",
    "fictional",
    "audio_available",
    "case_type",
    "revealed_hidden_ids",
    "learner_transcript",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CK-[CRP]0[1-4]-E[1-4]$"
    },
    "version": {
      "const": "0.1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_version": {
      "const": "0.1.0"
    },
    "review_notice": {
      "const": "草稿，待介护经验者与日语教育者审稿"
    },
    "fictional": {
      "const": true
    },
    "audio_available": {
      "const": false
    },
    "case_type": {
      "enum": [
        "positive",
        "common_error",
        "uncertain_transcript",
        "acceptable_variation"
      ]
    },
    "revealed_hidden_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "learner_transcript": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "utterance_id",
          "text_ja",
          "asr_quality"
        ],
        "additionalProperties": false,
        "properties": {
          "utterance_id": {
            "type": "string",
            "minLength": 1
          },
          "text_ja": {
            "type": "string",
            "minLength": 1
          },
          "asr_quality": {
            "enum": [
              "clear",
              "uncertain"
            ]
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "labels",
        "feedback_evidence",
        "next_step_zh",
        "must_not_claim_zh",
        "judgment_basis_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "required": [
            "clarification",
            "refusal_respect",
            "report_certainty"
          ],
          "additionalProperties": false,
          "properties": {
            "clarification": {
              "enum": [
                "met",
                "missed",
                "uncertain",
                "not_applicable"
              ]
            },
            "refusal_respect": {
              "enum": [
                "met",
                "missed",
                "uncertain",
                "not_applicable"
              ]
            },
            "report_certainty": {
              "enum": [
                "met",
                "missed",
                "uncertain",
                "not_applicable"
              ]
            }
          }
        },
        "feedback_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "utterance_id",
              "quote",
              "use_zh"
            ],
            "additionalProperties": false,
            "properties": {
              "utterance_id": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "use_zh": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "next_step_zh": {
          "type": "string",
          "minLength": 1
        },
        "must_not_claim_zh": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "judgment_basis_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:care-kotoba:eval-sample:0.1.0",
  "title": "Care Kotoba fixed transcript evaluation draft"
}
